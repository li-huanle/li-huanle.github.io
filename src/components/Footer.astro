---
const year = new Date().getFullYear();
---

<footer class="site-footer mt-28">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-12 md:py-16">
    <div class="footer-grid">
      <div class="footer-statement">
        <p class="eyebrow">HUANWORKS / GROWTH · DATA · AI</p>
        <h2>让增长判断留下证据，<br/>让有效动作成为系统。</h2>
      </div>
      <div class="footer-links">
        <div>
          <p>探索</p>
          <a href="/projects">项目案例</a>
          <a href="/methods">方法论库</a>
          <a href="/aios">AIOS</a>
        </div>
        <div>
          <p>联系</p>
          <a href="mailto:me@huanworks.com">复制邮箱</a>
          <a href="https://github.com/li-huanle" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© {year} Huanworks · 广告增长 × 数据分析 × AI 工作流</div>
      <div class="footer-friends">
        <span>FRIENDS</span>
        <a href="https://valuristories.com/" target="_blank" rel="noopener noreferrer">Valuri Stories ↗</a>
        <a href="https://video10x.app/" target="_blank" rel="noopener noreferrer">Video10x ↗</a>
      </div>
    </div>
  </div>

  <div
    id="email-copy-feedback"
    class="fixed left-1/2 bottom-6 z-50 -translate-x-1/2 rounded-full bg-[var(--color-fg)] px-4 py-2 text-sm text-[var(--color-bg)] shadow-lg opacity-0 pointer-events-none transition-opacity"
    role="status"
    aria-live="polite"
  ></div>
</footer>

<script>
  const email = "me@huanworks.com";
  const feedback = document.querySelector<HTMLElement>("#email-copy-feedback");
  let feedbackTimer: number | undefined;

  const showFeedback = (message: string) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.remove("opacity-0");
    window.clearTimeout(feedbackTimer);
    feedbackTimer = window.setTimeout(() => feedback.classList.add("opacity-0"), 2400);
  };

  const copyEmail = async () => {
    try {
      await navigator.clipboard.writeText(email);
      showFeedback(`邮箱已复制：${email}`);
    } catch {
      window.location.href = `mailto:${email}`;
      showFeedback("正在打开邮件客户端…");
    }
  };

  document.querySelectorAll<HTMLAnchorElement>(`a[href="mailto:${email}"]`).forEach((link) => {
    link.title = "点击复制邮箱地址";
    link.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      void copyEmail();
    });
  });
</script>
