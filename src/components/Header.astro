---
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects", label: "项目" },
  { href: "/cases", label: "案例" },
  { href: "/methods", label: "方法论" },
  { href: "/aios", label: "AIOS" },
  { href: "/blog", label: "笔记" },
  { href: "/about", label: "关于" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-[var(--color-border)] sticky top-0 backdrop-blur-md bg-black/60 z-50">
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-3 md:h-16 md:py-0 flex flex-col md:flex-row md:items-center gap-3 md:gap-6 md:justify-between">
    <a href="/" class="font-semibold tracking-tight text-lg">
      <span class="text-[var(--color-accent)]">/</span> huanle.li
    </a>
    <nav class="w-full md:w-auto flex items-center gap-4 md:gap-6 text-sm overflow-x-auto whitespace-nowrap pb-1 md:pb-0">
      {
        nav.map((item) => {
          const active =
            item.href === "/"
              ? pathname === "/"
              : pathname === item.href || pathname.startsWith(item.href + "/");
          return (
            <a
              href={item.href}
              class={`transition-colors hover:text-[var(--color-accent)] ${active ? "text-[var(--color-accent)]" : "text-[var(--color-fg-muted)]"}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
