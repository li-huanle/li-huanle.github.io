---
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects/", label: "项目" },
  { href: "/methods/", label: "方法论" },
  { href: "/blog/", label: "笔记" },
  { href: "/about/", label: "关于" },
];
const researchNav = [
  { href: "/cases/", label: "案例收藏", note: "外部案例与方法拆解" },
  { href: "/geo/", label: "GEO 指南", note: "从诊断到效果验收" },
  { href: "/aios/", label: "AIOS", note: "个人 AI 操作系统" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const researchActive = researchNav.some(
  (item) => {
    const itemPath = item.href.replace(/\/$/, "") || "/";
    return pathname === itemPath || pathname.startsWith(itemPath + "/");
  },
);
---

<header class="site-header sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 md:px-8 h-[4.5rem] flex items-center gap-5 justify-between">
    <a href="/" class="brand-lockup" aria-label="Huanworks 首页">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>
        <strong>Huanworks</strong>
        <small>Growth Systems</small>
      </span>
    </a>
    <nav class="hidden lg:flex items-center gap-1 text-sm whitespace-nowrap" aria-label="主导航">
      {
        nav.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const active =
            item.href === "/"
              ? pathname === "/"
              : pathname === itemPath || pathname.startsWith(itemPath + "/");
          return (
            <a
              href={item.href}
              class:list={["nav-link", { active }]}
            >
              {item.label}
            </a>
          );
        })
      }
      <details class="nav-popover">
        <summary class:list={["nav-link", { active: researchActive }]}>研究 <span aria-hidden="true">⌄</span></summary>
        <div class="nav-popover-panel">
          {researchNav.map((item) => (
            <a href={item.href}>
              <strong>{item.label}</strong>
              <small>{item.note}</small>
            </a>
          ))}
        </div>
      </details>
    </nav>

    <a href="/#project-contact" class="header-cta hidden lg:inline-flex">
      <span class="signal-dot"></span> 沟通项目
    </a>

    <details class="relative lg:hidden group mobile-menu">
      <summary class="mobile-menu-summary" aria-label="打开导航菜单">
        <span></span><span></span>
      </summary>
      <nav class="mobile-menu-panel" aria-label="移动端导航">
        {
          [...nav, ...researchNav].map((item) => {
            const itemPath = item.href.replace(/\/$/, "") || "/";
            const active =
              item.href === "/"
                ? pathname === "/"
                : pathname === itemPath || pathname.startsWith(itemPath + "/");
            return (
              <a
                href={item.href}
                class:list={["mobile-nav-link", { active }]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </details>
  </div>
</header>
