---
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects", label: "项目" },
  { href: "/cases", label: "案例" },
  { href: "/methods", label: "方法论" },
  { href: "/geo", label: "GEO" },
  { href: "/aios", label: "AIOS" },
  { href: "/blog", label: "笔记" },
  { href: "/about", label: "关于" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-[var(--color-border)] sticky top-0 backdrop-blur-md bg-black/80 z-50">
  <div class="max-w-5xl mx-auto px-4 md:px-6 h-16 flex items-center gap-4 justify-between">
    <a href="/" class="font-semibold tracking-tight text-lg">
      <span class="text-[var(--color-accent)]">/</span> Huanworks
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm whitespace-nowrap" aria-label="主导航">
      {
        nav.map((item) => {
          const active =
            item.href === "/"
              ? pathname === "/"
              : pathname === item.href || pathname.startsWith(item.href + "/");
          return (
            <a
              href={item.href}
              class={`transition-colors hover:text-[var(--color-accent)] ${active ? "text-[var(--color-accent)]" : "text-[var(--color-fg-muted)]"}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative md:hidden group">
      <summary class="mobile-menu-summary list-none min-h-11 min-w-11 px-3 flex items-center justify-center rounded border border-[var(--color-border)] text-sm text-[var(--color-fg-muted)] cursor-pointer hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
        菜单
      </summary>
      <nav class="absolute right-0 top-13 w-44 p-2 rounded border border-[var(--color-border)] bg-[var(--color-bg-elev)] shadow-xl" aria-label="移动端导航">
        {
          nav.map((item) => {
            const active =
              item.href === "/"
                ? pathname === "/"
                : pathname === item.href || pathname.startsWith(item.href + "/");
            return (
              <a
                href={item.href}
                class={`min-h-11 px-3 flex items-center rounded transition-colors hover:bg-[var(--color-bg-card)] hover:text-[var(--color-accent)] ${active ? "text-[var(--color-accent)]" : "text-[var(--color-fg-muted)]"}`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </details>
  </div>
</header>
