---
import Layout from "../../layouts/Layout.astro";
import ContactCta from "../../components/ContactCta.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const methods = await getCollection("methods");
  return methods.map((m) => ({
    params: { slug: m.id },
    props: { method: m },
  }));
}

const { method } = Astro.props;
const { Content } = await render(method);
const { data } = method;
const dateStr = data.date.toISOString().slice(0, 10);
const updatedDate = data.updated ?? data.date;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  datePublished: data.date.toISOString(),
  dateModified: updatedDate.toISOString(),
  inLanguage: "zh-CN",
  author: { "@type": "Person", name: "huanle", url: new URL("/about/", Astro.site).toString() },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  keywords: data.tags.join(", "),
};
---

<Layout title={`${data.title} — Huanworks`} description={data.summary} type="article" schema={articleJsonLd}>
  <article>
    <a
      href="/methods"
      class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] mb-8 inline-block transition-colors"
      >← 返回方法论库</a
    >

    <header class="border-b border-[var(--color-border)] pb-8 mb-8">
      <p class="text-xs font-mono text-[var(--color-accent)] tracking-widest mb-3">
        {data.domain} · {dateStr}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">
        {data.title}
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        {data.summary}
      </p>
      {
        data.sourceType && (
          <aside class="mt-6 rounded border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 text-sm leading-relaxed">
            <p class="font-medium text-[var(--color-fg)]">
              来源类型：{data.sourceType}
            </p>
            {data.sourceName && (
              <p class="mt-1 text-[var(--color-fg-muted)]">
                资料来源：{data.sourceName}
                {data.sourceDate && `（知识库整理于 ${data.sourceDate.toISOString().slice(0, 10)}）`}
              </p>
            )}
            {data.verificationNote && (
              <p class="mt-2 text-[var(--color-fg-muted)]">
                使用边界：{data.verificationNote}
              </p>
            )}
          </aside>
        )
      }
      {
        data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {data.tags.map((t) => (
              <span class="text-xs px-2 py-1 bg-[var(--color-bg-elev)] text-[var(--color-fg-muted)] font-mono rounded">
                #{t}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose-zh max-w-none">
      <Content />
    </div>

    <div class="mt-14">
      <ContactCta compact />
    </div>
  </article>
</Layout>
