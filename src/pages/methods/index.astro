---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const methods = (await getCollection("methods")).sort(
  (a, b) => a.data.order - b.data.order,
);

const grouped = methods.reduce(
  (acc, m) => {
    const k = m.data.domain;
    (acc[k] ??= []).push(m);
    return acc;
  },
  {} as Record<string, typeof methods>,
);

const domains = Object.keys(grouped);
---

<Layout
  title="增长投放与 AI 工作流方法论 — Huanworks"
  description="面向增长投放和 AI 工作流的可执行方法库，覆盖账户诊断、搜索投放、数据复盘、内容策略、RAG 和自动化验收。"
>
  <section class="py-12 border-b border-[var(--color-border)] mb-12">
    <p class="text-sm font-mono text-[var(--color-accent)] tracking-widest mb-3">
      METHODS
    </p>
    <h1 class="text-4xl font-bold mb-4">方法论库</h1>
    <p class="text-[var(--color-fg-muted)] max-w-2xl">
      每张卡片按「问题 / 前提 / 操作 / 判断 / 错误 / 边界」展开，覆盖广告增长、数据分析、
      AI 工作流、RAG、知识管理与产品验证。不是观点合集，而是可执行、可验收的 SOP。
    </p>
  </section>

  {
    domains.map((domain) => (
      <section class="mb-12">
        <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-4">
          {domain}
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {grouped[domain].map((m) => (
            <a
              href={`/methods/${m.id}`}
              class="block p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
            >
              <h3 class="font-semibold mb-2 leading-snug group-hover:text-[var(--color-accent)] transition-colors">
                {m.data.title}
              </h3>
              <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-3">
                {m.data.summary}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {m.data.tags.slice(0, 4).map((t) => (
                  <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-fg-dim)] font-mono rounded">
                    {t}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
