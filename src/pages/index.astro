---
import Layout from "../layouts/Layout.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const methods = (await getCollection("methods")).sort(
  (a, b) => a.data.order - b.data.order,
);
const cases = (await getCollection("cases")).sort(
  (a, b) => a.data.order - b.data.order,
);

const featuredProjects = projects.slice(0, 4);
const featuredMethods = methods.slice(0, 4);
const featuredCases = cases.slice(0, 3);
const contactHref = `mailto:me@huanworks.com?subject=${encodeURIComponent("Huanworks 项目沟通")}`;
---

<Layout>
  <!-- Hero -->
  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <p class="text-sm text-[var(--color-accent)] font-mono mb-4 tracking-widest">
      增长投放操盘手 · 8 年信息流经验 · 小红书聚光 / 巨量引擎
    </p>
    <h1 class="text-4xl md:text-6xl font-bold leading-tight tracking-tight mb-6">
      把投放数据变成增长动作<br/>
      <span class="text-[var(--color-accent)]">再把有效动作沉淀成 AI 工作流</span>
    </h1>
    <p class="text-lg text-[var(--color-fg-muted)] max-w-3xl leading-relaxed">
      我帮助品牌方、代理团队和增长负责人诊断投放问题，统一数据口径，优化内容、人群、搜索与承接链路，
      并把高频交付固化成 SOP、知识库和 Agent。
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={contactHref}
        class="min-h-12 px-6 inline-flex items-center bg-[var(--color-accent)] text-black font-medium rounded hover:bg-[var(--color-accent-soft)] transition-colors"
      >
        发我一个真实问题 →
      </a>
      <a
        href="/projects"
        class="min-h-12 px-6 inline-flex items-center border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors rounded"
      >
        查看已交付项目
      </a>
    </div>
    <div class="mt-10 grid sm:grid-cols-3 gap-3 max-w-3xl text-sm">
      <div class="p-3 border-l-2 border-[var(--color-accent)] bg-[var(--color-bg-card)]">8 年信息流投放经验</div>
      <div class="p-3 border-l-2 border-[var(--color-accent)] bg-[var(--color-bg-card)]">巨量引擎 × 小红书聚光</div>
      <div class="p-3 border-l-2 border-[var(--color-accent)] bg-[var(--color-bg-card)]">标注角色、状态与证据边界</div>
    </div>
  </section>

  <!-- 三大方向 -->
  <section class="py-16 border-b border-[var(--color-border)]">
    <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-8">
      我在做什么
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      {
        [
          {
            title: "投放诊断与增长策略",
            sub: "Account Diagnosis",
            body: "从业务目标和核心 KPI 出发，定位账户、内容、人群、搜索与承接链路中的关键问题，给出可验证的优化动作。",
            href: "/methods/account-diagnosis-checklist",
          },
          {
            title: "数据复盘与经营判断",
            sub: "Data → Insight → Action",
            body: "统一口径、清洗数据、拆解异常，把日报和复盘从“报数字”升级为可追踪、可验证的经营动作。",
            href: "/methods/growth-data-action-loop",
          },
          {
            title: "AI 工作流与知识库落地",
            sub: "AIOS & Knowledge Workflow",
            body: "把已经跑通的高频任务沉淀为 SOP、知识库、Skill 或 Agent，在保留人工审核的前提下减少重复劳动。",
            href: "/aios",
          },
        ].map((card) => (
          <a
            href={card.href ?? null}
            class={`block p-6 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded transition-colors ${card.href ? "hover:border-[var(--color-accent)]" : ""}`}
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {card.sub}
            </p>
            <h3 class="text-xl font-semibold mb-3">{card.title}</h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">
              {card.body}
            </p>
            {card.href && (
              <p class="text-xs text-[var(--color-accent)] font-mono mt-3">
                查看详情 →
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- GEO 专题 -->
  <section class="py-10 border-b border-[var(--color-border)]">
    <a
      href="/geo"
      class="block md:flex items-center justify-between gap-8 p-6 md:p-8 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
    >
      <div>
        <p class="text-xs font-mono text-[var(--color-accent)] mb-2">NEW · GEO FIELD GUIDE</p>
        <h2 class="text-2xl font-semibold mb-3 group-hover:text-[var(--color-accent)] transition-colors">
          从品牌诊断到效果验收：8 章 GEO 实战指南
        </h2>
        <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed max-w-2xl">
          不讲固定排名和批量软文，按“问题库 → 基线 → 事实资产 → 内容 → 信源 → 复测 → 合规”跑完一轮可验收闭环。
        </p>
      </div>
      <span class="inline-block mt-5 md:mt-0 text-sm text-[var(--color-accent)] whitespace-nowrap">开始阅读 →</span>
    </a>
  </section>

  <!-- 精选项目 -->
  <section class="py-16 border-b border-[var(--color-border)]">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
          精选项目
        </h2>
        <p class="text-2xl font-semibold">问题 → 方法 → 结果</p>
      </div>
      <a
        href="/projects"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部项目 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {
        featuredProjects.map((p) => (
          <a
            href={`/projects/${p.id}`}
            class="block p-6 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-accent)] font-mono rounded">
                {p.data.status}
              </span>
              {p.data.role && (
                <span class="text-xs text-[var(--color-fg-dim)] font-mono">
                  {p.data.role}
                </span>
              )}
            </div>
            <h3 class="text-lg font-semibold mb-3 group-hover:text-[var(--color-accent)] transition-colors">
              {p.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4 line-clamp-3">
              {p.data.summary}
            </p>
            {p.data.highlight && (
              <p class="text-sm text-[var(--color-accent-soft)] border-l-2 border-[var(--color-accent)] pl-3 italic">
                {p.data.highlight}
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 案例收藏 -->
  {featuredCases.length > 0 && (
    <section class="py-16 border-b border-[var(--color-border)]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
            案例收藏
          </h2>
          <p class="text-2xl font-semibold">从同行案例里抽出的方法论</p>
        </div>
        <a
          href="/cases"
          class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          全部案例 →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {featuredCases.map((c) => (
          <a
            href={`/cases/${c.id}`}
            class="block p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <p class="text-xs font-mono text-[var(--color-fg-dim)] mb-2">
              {c.data.source}
              {c.data.sourceAuthor && ` · ${c.data.sourceAuthor}`}
            </p>
            <h3 class="font-semibold mb-2 leading-snug group-hover:text-[var(--color-accent)] transition-colors">
              {c.data.title}
            </h3>
            {c.data.takeaway && (
              <p class="text-sm text-[var(--color-fg-muted)] italic line-clamp-3">
                {c.data.takeaway}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 方法论 -->
  <section class="py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
          方法论库
        </h2>
        <p class="text-2xl font-semibold">能跑通的 SOP，不是观点</p>
      </div>
      <a
        href="/methods"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部方法论 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        featuredMethods.map((m) => (
          <a
            href={`/methods/${m.id}`}
            class="block p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {m.data.domain}
            </p>
            <h3 class="font-semibold mb-2 group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {m.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] line-clamp-2 leading-relaxed">
              {m.data.summary}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <ContactCta />
</Layout>
