---
import Layout from "../layouts/Layout.astro";
import ContactCta from "../components/ContactCta.astro";
import GrowthLoop from "../components/GrowthLoop.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const methods = (await getCollection("methods")).sort(
  (a, b) => a.data.order - b.data.order,
);
const cases = (await getCollection("cases")).sort(
  (a, b) => a.data.order - b.data.order,
);

const featuredProjects = projects.slice(0, 4);
const featuredMethods = methods.slice(0, 4);
const featuredCases = cases.slice(0, 3);
const contactHref = "#project-contact";
---

<Layout>
  <!-- Hero -->
  <section class="home-hero">
    <div class="hero-copy">
      <div class="hero-status">
        <span class="signal-dot"></span>
        <span>增长投放操盘手</span>
        <i></i>
        <span>8 年信息流经验</span>
      </div>
      <h1>
        把投放数据<br/>变成<span>增长动作</span>
      </h1>
      <p class="hero-thesis">再把有效动作，沉淀成可复用的 AI 工作流。</p>
      <p class="hero-description">
        面向品牌方、代理团队和增长负责人，诊断投放问题，统一数据口径，优化内容、人群、搜索与承接链路。
      </p>
      <div class="hero-actions">
        <a href={contactHref} class="button-primary">发送项目问题 <span>↗</span></a>
        <a href="/projects/" class="button-secondary">查看已交付项目 <span>→</span></a>
      </div>
    </div>
    <GrowthLoop />
    <div class="hero-proof" aria-label="经验与专业领域">
      <div><span>01</span><strong>8 年</strong><small>信息流投放经验</small></div>
      <div><span>02</span><strong>双平台</strong><small>巨量引擎 × 小红书聚光</small></div>
      <div><span>03</span><strong>可验证</strong><small>角色、状态与证据边界</small></div>
    </div>
  </section>

  <!-- 三大方向 -->
  <section class="home-section">
    <div class="section-heading">
      <p>01 / CAPABILITIES</p>
      <h2>我在做什么</h2>
      <span>把复杂的增长问题，拆成能执行、能回读、能迭代的动作。</span>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: "投放诊断与增长策略",
            sub: "Account Diagnosis",
            body: "从业务目标和核心 KPI 出发，定位账户、内容、人群、搜索与承接链路中的关键问题，给出可验证的优化动作。",
            href: "/methods/account-diagnosis-checklist/",
          },
          {
            title: "数据复盘与经营判断",
            sub: "Data → Insight → Action",
            body: "统一口径、清洗数据、拆解异常，把日报和复盘从“报数字”升级为可追踪、可验证的经营动作。",
            href: "/methods/growth-data-action-loop/",
          },
          {
            title: "AI 工作流与知识库落地",
            sub: "AIOS & Knowledge Workflow",
            body: "把已经跑通的高频任务沉淀为 SOP、知识库、Skill 或 Agent，在保留人工审核的前提下减少重复劳动。",
            href: "/aios/",
          },
        ].map((card) => (
          <a
            href={card.href ?? null}
            class="capability-card"
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {card.sub}
            </p>
            <h3 class="text-xl font-semibold mb-3">{card.title}</h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">
              {card.body}
            </p>
            {card.href && (
            <p class="card-link">
                查看能力详情 <span>↗</span>
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- GEO 专题 -->
  <section class="feature-band">
    <a
      href="/geo/"
      class="feature-band-link group"
    >
      <div>
        <p class="text-xs font-mono text-[var(--color-accent)] mb-2">NEW · GEO FIELD GUIDE</p>
        <h2 class="text-2xl font-semibold mb-3 group-hover:text-[var(--color-accent)] transition-colors">
          从品牌诊断到效果验收：8 章 GEO 实战指南
        </h2>
        <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed max-w-2xl">
          不讲固定排名和批量软文，按“问题库 → 基线 → 事实资产 → 内容 → 信源 → 复测 → 合规”跑完一轮可验收闭环。
        </p>
      </div>
      <span class="inline-block mt-5 md:mt-0 text-sm text-[var(--color-accent)] whitespace-nowrap">开始阅读 →</span>
    </a>
  </section>

  <!-- 精选项目 -->
  <section class="home-section">
    <div class="section-heading section-heading-row">
      <div>
        <p>02 / SELECTED WORK</p>
        <h2>问题 → 方法 → 结果</h2>
      </div>
      <a
        href="/projects/"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部项目 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {
        featuredProjects.map((p) => (
          <a
            href={`/projects/${p.id}/`}
            class="project-card group"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-accent)] font-mono rounded">
                {p.data.status}
              </span>
              {p.data.role && (
                <span class="text-xs text-[var(--color-fg-dim)] font-mono">
                  {p.data.role}
                </span>
              )}
            </div>
            <h3 class="text-lg font-semibold mb-3 group-hover:text-[var(--color-accent)] transition-colors">
              {p.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4 line-clamp-3">
              {p.data.summary}
            </p>
            {p.data.highlight && (
              <p class="text-sm text-[var(--color-accent-soft)] border-l-2 border-[var(--color-accent)] pl-3 italic">
                {p.data.highlight}
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 案例收藏 -->
  {featuredCases.length > 0 && (
    <section class="home-section">
      <div class="section-heading section-heading-row">
        <div>
          <p>03 / CASE NOTES</p>
          <h2>从同行案例里抽出的方法论</h2>
        </div>
        <a
          href="/cases/"
          class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          全部案例 →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {featuredCases.map((c) => (
          <a
            href={`/cases/${c.id}/`}
            class="case-card group"
          >
            <p class="text-xs font-mono text-[var(--color-fg-dim)] mb-2">
              {c.data.source}
              {c.data.sourceAuthor && ` · ${c.data.sourceAuthor}`}
            </p>
            <h3 class="font-semibold mb-2 leading-snug group-hover:text-[var(--color-accent)] transition-colors">
              {c.data.title}
            </h3>
            {c.data.takeaway && (
              <p class="text-sm text-[var(--color-fg-muted)] italic line-clamp-3">
                {c.data.takeaway}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 方法论 -->
  <section class="home-section home-section-last">
    <div class="section-heading section-heading-row">
      <div>
        <p>04 / PLAYBOOKS</p>
        <h2>能跑通的 SOP，不是观点</h2>
      </div>
      <a
        href="/methods/"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部方法论 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        featuredMethods.map((m) => (
          <a
            href={`/methods/${m.id}/`}
            class="method-card group"
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {m.data.domain}
            </p>
            <h3 class="font-semibold mb-2 group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {m.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] line-clamp-2 leading-relaxed">
              {m.data.summary}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <ContactCta />
</Layout>
