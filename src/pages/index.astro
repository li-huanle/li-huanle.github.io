---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const methods = (await getCollection("methods")).sort(
  (a, b) => a.data.order - b.data.order,
);
const cases = (await getCollection("cases")).sort(
  (a, b) => a.data.order - b.data.order,
);

const featuredProjects = projects.slice(0, 4);
const featuredMethods = methods.slice(0, 4);
const featuredCases = cases.slice(0, 3);
---

<Layout>
  <!-- Hero -->
  <section class="py-16 md:py-24 border-b border-[var(--color-border)]">
    <p class="text-sm text-[var(--color-accent)] font-mono mb-4 tracking-widest">
      GROWTH OPERATOR · 8 年信息流广告经验
    </p>
    <h1 class="text-4xl md:text-6xl font-bold leading-tight tracking-tight mb-6">
      把数据、投放与 AI 工作流<br/>
      <span class="text-[var(--color-accent)]">跑成可复用的增长系统</span>
    </h1>
    <p class="text-lg text-[var(--color-fg-muted)] max-w-2xl leading-relaxed">
      从小红书聚光、巨量引擎与真实业务数据出发，把问题拆成指标、把数据变成判断、把判断落成动作，
      再把有效经验沉淀为 SOP、知识库、Agent 或独立产品。
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/projects"
        class="px-6 py-3 bg-[var(--color-accent)] text-black font-medium rounded hover:bg-[var(--color-accent-soft)] transition-colors"
      >
        看项目案例 →
      </a>
      <a
        href="/methods"
        class="px-6 py-3 border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors rounded"
      >
        看方法论
      </a>
    </div>
  </section>

  <!-- 四大方向 -->
  <section class="py-16 border-b border-[var(--color-border)]">
    <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-8">
      我在做什么
    </h2>
    <div class="grid md:grid-cols-2 gap-6">
      {
        [
          {
            title: "投放诊断",
            sub: "Account Diagnosis",
            body: "围绕客户核心 KPI，拆账户、内容、人群、搜索与承接链路，先确认事实，再排优化优先级。",
          },
          {
            title: "数据分析与经营复盘",
            sub: "Data → Insight → Action",
            body: "统一口径、清洗数据、定位异常，把日报和复盘从报数升级为可追踪的动作清单与验证结果。",
            href: "/methods/growth-data-action-loop",
          },
          {
            title: "AI / 自动化 / 知识库",
            sub: "AIOS & Knowledge Workflow",
            body: "用 Obsidian、RAG、本地 LLM、Skills 与可选的 n8n 编排层，建立有来源、有边界、可验收的工作流。",
            href: "/aios",
          },
          {
            title: "独立产品与技术实践",
            sub: "Product Experiments",
            body: "从高频业务动作里发现需求，用窄 MVP 验证使用与付费，再决定是否工程化为工具、服务或 SaaS。",
            href: "/projects",
          },
        ].map((card) => (
          <a
            href={card.href ?? null}
            class={`block p-6 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded transition-colors ${card.href ? "hover:border-[var(--color-accent)]" : ""}`}
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {card.sub}
            </p>
            <h3 class="text-xl font-semibold mb-3">{card.title}</h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">
              {card.body}
            </p>
            {card.href && (
              <p class="text-xs text-[var(--color-accent)] font-mono mt-3">
                查看详情 →
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="py-16 border-b border-[var(--color-border)]">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
          精选项目
        </h2>
        <p class="text-2xl font-semibold">问题 → 方法 → 结果</p>
      </div>
      <a
        href="/projects"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部项目 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {
        featuredProjects.map((p) => (
          <a
            href={`/projects/${p.id}`}
            class="block p-6 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-accent)] font-mono rounded">
                {p.data.status}
              </span>
              {p.data.role && (
                <span class="text-xs text-[var(--color-fg-dim)] font-mono">
                  {p.data.role}
                </span>
              )}
            </div>
            <h3 class="text-lg font-semibold mb-3 group-hover:text-[var(--color-accent)] transition-colors">
              {p.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4 line-clamp-3">
              {p.data.summary}
            </p>
            {p.data.highlight && (
              <p class="text-sm text-[var(--color-accent-soft)] border-l-2 border-[var(--color-accent)] pl-3 italic">
                {p.data.highlight}
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 案例收藏 -->
  {featuredCases.length > 0 && (
    <section class="py-16 border-b border-[var(--color-border)]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
            案例收藏
          </h2>
          <p class="text-2xl font-semibold">从同行案例里抽出的方法论</p>
        </div>
        <a
          href="/cases"
          class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          全部案例 →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {featuredCases.map((c) => (
          <a
            href={`/cases/${c.id}`}
            class="block p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <p class="text-xs font-mono text-[var(--color-fg-dim)] mb-2">
              {c.data.source}
              {c.data.sourceAuthor && ` · ${c.data.sourceAuthor}`}
            </p>
            <h3 class="font-semibold mb-2 leading-snug group-hover:text-[var(--color-accent)] transition-colors">
              {c.data.title}
            </h3>
            {c.data.takeaway && (
              <p class="text-sm text-[var(--color-fg-muted)] italic line-clamp-3">
                {c.data.takeaway}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 方法论 -->
  <section class="py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-sm font-mono text-[var(--color-fg-dim)] tracking-widest mb-2">
          方法论库
        </h2>
        <p class="text-2xl font-semibold">能跑通的 SOP，不是观点</p>
      </div>
      <a
        href="/methods"
        class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部方法论 →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        featuredMethods.map((m) => (
          <a
            href={`/methods/${m.id}`}
            class="block p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded hover:border-[var(--color-accent)] transition-colors group"
          >
            <p class="text-xs font-mono text-[var(--color-accent)] mb-2">
              {m.data.domain}
            </p>
            <h3 class="font-semibold mb-2 group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {m.data.title}
            </h3>
            <p class="text-sm text-[var(--color-fg-muted)] line-clamp-2 leading-relaxed">
              {m.data.summary}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
