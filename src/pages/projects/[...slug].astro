---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const dateStr = data.date.toISOString().slice(0, 10);
---

<Layout title={`${data.title} — huanle.li`} description={data.summary}>
  <article>
    <a
      href="/projects"
      class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] mb-8 inline-block transition-colors"
      >← 返回项目列表</a
    >

    <header class="border-b border-[var(--color-border)] pb-8 mb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-accent)] font-mono rounded">
          {data.status}
        </span>
        {data.role && (
          <span class="text-xs font-mono text-[var(--color-fg-dim)]">
            {data.role}
          </span>
        )}
        <span class="text-xs font-mono text-[var(--color-fg-dim)]">
          {dateStr}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">
        {data.title}
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        {data.summary}
      </p>

      {
        data.metrics.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
            {data.metrics.map((m) => (
              <div class="p-4 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded">
                <div class="text-xs text-[var(--color-fg-dim)] font-mono mb-1">
                  {m.label}
                </div>
                <div class="text-lg font-semibold text-[var(--color-accent)]">
                  {m.value}
                </div>
              </div>
            ))}
          </div>
        )
      }

      {
        data.stack.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {data.stack.map((s) => (
              <span class="text-xs px-2 py-1 bg-[var(--color-bg-elev)] text-[var(--color-fg-muted)] font-mono rounded">
                {s}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose-zh max-w-none">
      <Content />
    </div>
  </article>
</Layout>
