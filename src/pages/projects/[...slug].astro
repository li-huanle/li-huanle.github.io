---
import Layout from "../../layouts/Layout.astro";
import ContactCta from "../../components/ContactCta.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const updatedDate = data.updated ?? data.date;
const updatedStr = updatedDate.toISOString().slice(0, 10);
const statusNeedsRefresh = data.status !== "已交付" && Date.now() - updatedDate.getTime() > 90 * 86400000;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  datePublished: data.date.toISOString(),
  dateModified: updatedDate.toISOString(),
  inLanguage: "zh-CN",
  author: { "@type": "Person", name: "huanle", url: new URL("/about/", Astro.site).toString() },
  mainEntityOfPage: canonicalURL.toString(),
};
---

<Layout title={`${data.title} — Huanworks`} description={data.summary} type="article" schema={articleJsonLd}>
  <article>
    <a
      href="/projects"
      class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] mb-8 inline-block transition-colors"
      >← 返回项目列表</a
    >

    <header class="border-b border-[var(--color-border)] pb-8 mb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="text-xs px-2 py-0.5 bg-[var(--color-bg-elev)] text-[var(--color-accent)] font-mono rounded">
          {data.status}
        </span>
        {data.role && (
          <span class="text-xs font-mono text-[var(--color-fg-dim)]">
            {data.role}
          </span>
        )}
        <span class="text-xs font-mono text-[var(--color-fg-dim)]">
          状态截至 {updatedStr}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">
        {data.title}
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        {data.summary}
      </p>

      {
        data.metrics.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
            {data.metrics.map((m) => (
              <div class="p-4 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded">
                <div class="text-xs text-[var(--color-fg-dim)] font-mono mb-1">
                  {m.label}
                </div>
                <div class="text-lg font-semibold text-[var(--color-accent)]">
                  {m.value}
                </div>
              </div>
            ))}
          </div>
        )
      }

      {
        data.stack.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {data.stack.map((s) => (
              <span class="text-xs px-2 py-1 bg-[var(--color-bg-elev)] text-[var(--color-fg-muted)] font-mono rounded">
                {s}
              </span>
            ))}
          </div>
        )
      }

      {statusNeedsRefresh && (
        <p class="mt-6 p-3 border border-[var(--color-border)] rounded text-sm text-[var(--color-fg-muted)]">
          页面状态已超过 90 天未更新，“{data.status}”仅代表最后一次公开记录，不代表项目当前仍在执行。
        </p>
      )}
    </header>

    <section class="mb-10 grid md:grid-cols-3 gap-4" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading" class="sr-only">结果与证据</h2>
      <div class="p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded">
        <p class="text-xs font-mono text-[var(--color-accent)] tracking-widest mb-3">已完成</p>
        {data.deliverables.length > 0 ? (
          <ul class="text-sm text-[var(--color-fg-muted)] list-disc pl-5 space-y-2">
            {data.deliverables.map((item) => <li>{item}</li>)}
          </ul>
        ) : <p class="text-sm text-[var(--color-fg-muted)]">公开页暂未拆分交付物。</p>}
      </div>
      <div class="p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded">
        <p class="text-xs font-mono text-[var(--color-accent)] tracking-widest mb-3">已观察到</p>
        {data.observed.length > 0 ? (
          <ul class="text-sm text-[var(--color-fg-muted)] list-disc pl-5 space-y-2">
            {data.observed.map((item) => <li>{item}</li>)}
          </ul>
        ) : <p class="text-sm text-[var(--color-fg-muted)]">暂无可公开的结果数据，不用交付状态替代业务结果。</p>}
      </div>
      <div class="p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded">
        <p class="text-xs font-mono text-[var(--color-accent)] tracking-widest mb-3">尚未验证</p>
        {data.unverified.length > 0 ? (
          <ul class="text-sm text-[var(--color-fg-muted)] list-disc pl-5 space-y-2">
            {data.unverified.map((item) => <li>{item}</li>)}
          </ul>
        ) : <p class="text-sm text-[var(--color-fg-muted)]">暂无补充项。</p>}
      </div>
      {data.evidence && (
        <p class="md:col-span-3 p-4 border-l-2 border-[var(--color-accent)] bg-[var(--color-bg-card)] text-sm text-[var(--color-fg-muted)]">
          <strong class="text-[var(--color-fg)]">证据边界：</strong>{data.evidence}
        </p>
      )}
    </section>

    <div class="prose-zh max-w-none">
      <Content />
    </div>

    <div class="mt-14">
      <ContactCta compact />
    </div>
  </article>
</Layout>
