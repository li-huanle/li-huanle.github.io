---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const dateStr = data.date.toISOString().slice(0, 10);
---

<Layout title={`${data.title} — huanle.li`} description={data.summary}>
  <article>
    <a
      href="/blog"
      class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] mb-8 inline-block transition-colors"
      >← 返回笔记列表</a
    >

    <header class="border-b border-[var(--color-border)] pb-8 mb-8">
      <p class="text-xs font-mono text-[var(--color-fg-dim)] mb-3">{dateStr}</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">
        {data.title}
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        {data.summary}
      </p>
    </header>

    <div class="prose-zh max-w-none">
      <Content />
    </div>
  </article>
</Layout>
